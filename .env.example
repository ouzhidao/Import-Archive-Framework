# ========== 复制本文件为 .env 后填写真实值 ==========
# .env 已被 .gitignore 屏蔽，绝不进 Git。

# 百度 OCR（主轨，M3）—— 多账户主备，各 1000 次/月免费
BAIDU_OCR_AK_A=你的百度APIKey_A
BAIDU_OCR_SK_A=你的百度SecretKey_A
BAIDU_OCR_AK_B=你的百度APIKey_B
BAIDU_OCR_SK_B=你的百度SecretKey_B
# C（可选第三账户，配额用尽自动切换）
BAIDU_OCR_AK_C=你的百度APIKey_C
BAIDU_OCR_SK_C=你的百度SecretKey_C

# OpenAI 兼容 vision（可选兜底轨，低置信例外时用；不填也能跑）
OCR_VISION_API_BASE=https://api.openai.com/v1
OCR_VISION_API_KEY=sk-your-key-here
OCR_VISION_MODEL=gpt-4o
OCR_VISION_MAX_TOKENS=2048
OCR_VISION_TEMPERATURE=0.1
